    "abi": "forge build --silent && node scripts/gen-abi.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "playwright": "^1.57.0",
    "qrcode-generator": "^1.4.4",
    "viem": "^2.21.0"
  }
}
